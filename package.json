{
  "name": "hamqslprint",
  "version": "0.3.0",
  "description": "Generate QSL label PDFs from amateur radio log files and YAML templates",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/hamqslprint.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hamqslprint.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:log": "npm run build",
    "test:log": "node scripts/select-fields.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "yaml": "^2.9.1"
  }
}
